	pages = {102256},
	year = {2025},
	issn = {0197-4556},
	preview = {arts_in_psychotherapy.gif},
	doi = {10.1016/j.aip.2025.102256},
	url = {https://www.sciencedirect.com/science/article/pii/S0197455625000097},
	author = {Bennett, Bailey J. and Corn, Clara A. and {Wolf Bordonaro}, Gaelynn P. and Wylie, Keith},
	keywords = {Art therapy, Brain injury, Anxiety, Single session, Collage intervention},
	abstract = {Traumatic Brain Injuries (TBIs) are life-changing events that can contribute to the development of anxiety and depression, both of which are closely associated with poor overall outcomes. Brain injury may impact cognitive and physiological functions, regulation of mood, interpersonal relationships, personal identity, and self-esteem.},
}

@article{Wylie2023,
	title = {Investigating the utility of cognitive interview mnemonics among non-native {English} speakers},
	selected = {true},
	issn = {2083-8506},
	url = {https://sciendo.com/article/10.58734/plc-2023-0012},
	doi = {10.58734/plc-2023-0012},
	abstract = {Best practice eyewitness interviewing mnemonics have not been tested with linguistically diverse samples. Cognitively complex mnemonics may overload non-native speakers' cognitive resources, which are already engaged in speaking a non-native language. Social facilitation mnemonics may help non-native speakers, who might be hesitant to report details. The current study tested the reverse order mnemonic (cognitively complex) and a set of introductory instructions (social facilitation) compared to control interviews among native and non-native English speakers. Native speakers provided more details than non-native speakers, particularly in the control interview condition. Both the reverse order and control conditions elicited newly generated details because of repeated questioning. Accuracy rates were comparable across language and interview conditions. Future research should develop an interviewing protocol that is sensitive to the challenges faced by non-native speakers.},
	journal = {Psychology of Language and Communication},
	author = {Wylie, Keith and Evans, Jacqueline R.},
	month = apr,
	preview = {plc.jpg},
	year = {2023},
	pages = {226--255},
}

@article{Wylie2022,
	title = {Observers' accuracy in detecting deception in non-native speakers versus native speakers: A systematic review},
	volume = {19},
	issn = {1544-4759, 1544-4767},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/jip.1595},
	doi = {10.1002/jip.1595},
	abstract = {As immigration and homeland security become of greater concern both at a global and national level, it is imperative to review existing research on observers' ability to accurately detect deception in non-native speakers. Objectives of this systematic review were to summarise the evidence on adult observers' ability to accurately detect deception in non-native speakers compared to native speakers; identify response biases in observers' judgements when judging native versus non-native speakers' statements; and explore whether differences in observers' deception detection accuracy varies across targets' proficiency levels. Two reviewers independently searched five databases and screened for all quantitative studies that met pre-selected search criteria. Out of 1885 records identified through database searching, 11 studies met the inclusion criteria. Discriminability for non-native speakers was above chance in four samples. Most studies found support for a lie bias when judging non-native speakers and a truth bias when judging native speakers. In addition to further research, these results highlight the need for better reporting of stimuli and observer samples as well as a standardised measure of individuals' proficiency level.},
	number = {3},
	journal = {Journal of Investigative Psychology and Offender Profiling},
	author = {Wylie, Keith and Pena, Michelle M. and Miller, Kevin B. and Palmer, Maley E. and Tate, Elizabeth},
	month = oct,
	year = {2022},
	preview = {jip.jpg},
	pages = {204--220},
}

@article{Verschuere2018,
	title = {Registered replication report on {Mazar}, {Amir}, and {Ariely} (2008)},
	volume = {1},
	issn = {2515-2459, 2515-2467},
	url = {http://journals.sagepub.com/doi/10.1177/2515245918781032},
	doi = {10.1177/2515245918781032},
	abstract = {The self-concept maintenance theory holds that many people will cheat in order to maximize self-profit, but only to the extent that they can do so while maintaining a positive self-concept. Here we test the generalizability of 1 important finding of Mazar et al.: a moderate positive effect of the activating the concept of dishonesty on dishonest behavior. Sixty-two samples (total n = 4,080) conducted this Registered Replication Report. Acknowledging differences in sample characteristics, contextual factors, and statistical power, we nevertheless expected to replicate the original effect. Meta-analytic results indicate that the mean effect size was significantly smaller than the original effect but in the same direction as the original effect. Results suggest that the effect of activating the concept of dishonesty on dishonest behavior is real but small.},
	number = {3},
	journal = {Advances in Methods and Practices in Psychological Science},
	author = {Verschuere, Bruno and Meijer, Ewout H. and Jim, Ariane and Hoogesteyn, Katherine and Orthey, Robin and McCarthy, Randy J. and Skowronski, John J. and Acar, Oguz A. and Aczel, Balazs and others},
	month = sep,
	year = {2018},
	pages = {299--317},
}

@article{Tate2023,
	title = {The effects of face masks on emotional appraisal ability of students with autism spectrum disorder},
	issn = {2047-3869, 2047-3877},
	url = {https://www.tandfonline.com/doi/full/10.1080/20473869.2023.2189765},
	doi = {10.1080/20473869.2023.2189765},
	abstract = {The impact of the COVID-19 pandemic has drastically altered the ways in which people are able to communicate effectively. The addition of the face mask as a distracting stimulus interrupts the holistic process that people use to interpret facial expressions. The present study seeks to investigate the impact of face masking and gaze direction on emotion recognition in students with autism. We predicted that students with autism (n = 14), who characteristically experience difficulties when appraising emotions, would struggle to assess the emotions of people wearing face masks. We did not find a significant three-way interaction of emotion, mask, and gaze on classification accuracy. We did, however, find that face masks reduced participants' ability to emotionally appraise sad faces. Further, participants showed better accuracy appraising faces with a direct gaze. Exploring how face masks impact autistic individuals' emotion recognition will benefit special educators as they adapt to teaching during the pandemic, as well as the general population that seeks to improve communication with neurodiverse persons. Future studies should examine emotional appraisal ability and additional emotions as well as different kinds of emotional stimuli.},
	journal = {International Journal of Developmental Disabilities},
	author = {Tate, Elizabeth and Wylie, Keith and Moss, Jennifer D.},
	month = mar,
	year = {2023},
	preview = {ijdd.jpg},
	pages = {1--9},
}

@article{PSACollaboration2022,
	title = {A global experiment on motivating social distancing during the {COVID}-19 pandemic},
	volume = {119},
	issn = {0027-8424, 1091-6490},
	url = {https://pnas.org/doi/full/10.1073/pnas.2111091119},
	doi = {10.1073/pnas.2111091119},
	preview = {pnas.webp},
	abstract = {Finding communication strategies that effectively motivate social distancing continues to be a global public health priority during the COVID-19 pandemic. This cross-country, preregistered experiment (n = 25,718 from 89 countries) tested hypotheses concerning generalizable positive and negative outcomes of social distancing messages that promoted personal agency and reflective choice. Following Self-determination Theory, we hypothesized that messages emphasizing personal agency would be more persuasive than controlling messages. Multilevel regression results indicated that messages promoting agency resulted in greater reported intentions to engage in social distancing relative to controlling messages, with this effect particularly pronounced among those who had not been following social distancing guidelines. Effects did not differ significantly across country clusters, age, gender, or political ideology. These findings suggest that promoting autonomy is a promising approach for motivating adherence to social distancing guidelines across diverse populations during the COVID-19 pandemic.},
	number = {22},
	journal = {Proceedings of the National Academy of Sciences},
	author = {{Psychological Science Accelerator Self-Determination Theory Collaboration} and Legate, Nicole and Nguyen, Thuy-vy and Weinstein, Netta and Moller, Arlen and Legault, Lisa and others},
	month = may,
	year = {2022},
	pages = {e2111091119},
}

@article{Molinaro2021,
	title = {Pre-identification confidence is related to eyewitness lineup identification accuracy across heterogeneous encoding conditions},
	volume = {45},
	issn = {1573-661X, 0147-7307},
	url = {https://doi.apa.org/doi/10.1037/lhb0000452},
	doi = {10.1037/lhb0000452},
	abstract = {Eyewitness research has generally failed to show an association between eyewitnesses' pre-identification confidence in their ability to identify the perpetrator from a lineup and their subsequent identification accuracy. However, this observed lack of an association may be an artifact of methodologies in which witnesses experienced homogenous encoding conditions, which would tend to mask the relationship between pre-identification confidence and identification accuracy. The present research tests whether pre-identification confidence predicts eyewitness identification accuracy across witnesses who experienced heterogeneous encoding conditions. A total of 1,236 participants watched a mock crime video and completed a confidence judgment before attempting a simultaneous or sequential lineup identification. Results show that preidentification confidence is significantly related to accuracy, with higher accuracy for confident participants. In addition, participants who identified a suspect were more confident than those who did not identify anyone, but confidence did not differ significantly across lineup types or between correct and incorrect identifications of the suspect.},
	number = {6},
	journal = {Law and Human Behavior},
	author = {Molinaro, Peter F. and Charman, Steve D. and Wylie, Keith},
	month = dec,
	year = {2021},
	preview = {lhb.gif},
	pages = {524--541},
}

@article{McCarthy2018,
	title = {Registered replication report on {Srull} and {Wyer} (1979)},
	volume = {1},
	issn = {2515-2459, 2515-2467},
	url = {http://journals.sagepub.com/doi/10.1177/2515245918777487},
	doi = {10.1177/2515245918777487},
	abstract = {Srull and Wyer (1979) demonstrated that exposing participants to more hostility-related stimuli caused them subsequently to interpret ambiguous behaviors as more hostile. In their Experiment 1, participants first judged either 0, 1, 5, or 10 sentences related to hostility and then read a paragraph containing information about a target person that was ambiguous with respect to hostility. Participants exposed to more hostility-related materials rated the target person as more hostile. In this Registered Replication Report, we attempted to replicate this effect and to explore whether working memory load or priming duration moderates this effect. A total of 10 laboratories ran the experiment with a combined sample of 1,294 U.S. and U.K. undergraduate students. Meta-analytic findings indicated that exposure to hostility-related primes significantly increased hostility judgments of the target person, with this effect observed across 8 of the 10 laboratories. The magnitude of this effect was comparable with the original effect reported by Srull and Wyer. Working memory load did not moderate this effect.},
	number = {3},
	journal = {Advances in Methods and Practices in Psychological Science},
	author = {McCarthy, Randy J. and Skowronski, John J. and Verschuere, Bruno and Meijer, Ewout H. and Jim, Ariane and Hoogesteyn, Katherine and Orthey, Robin and Acar, Oguz A. and Aczel, Balazs and others},
	month = sep,
	year = {2018},
	pages = {321--336},
}
