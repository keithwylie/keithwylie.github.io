@article{WylieEvans2023,
  title = {Investigating the utility of cognitive interview mnemonics among non-native {English} speakers},
  volume = {27},
  number = {1},
  journal = {Psychology of Language and Communication},
  author = {Wylie, Keith and Evans, Jacqueline R.},
  year = {2023},
  month = apr,
  pages = {226--255},
  doi = {10.58734/plc-2023-0012},
  url = {https://doi.org/10.58734/plc-2023-0012},
  issn = {2083-8506},
  abstract = {Best practice eyewitness interviewing mnemonics have not been tested with linguistically diverse samples. Cognitively complex mnemonics may overload non-native speakers' cognitive resources, which are already engaged in speaking a non-native language. Social facilitation mnemonics may help non-native speakers, who might be hesitant to report details. The current study tested the reverse order mnemonic and a set of introductory instructions compared to control interviews among native and non-native English speakers. Native speakers provided more details than non-native speakers, particularly in the control interview condition. Both the reverse order and control conditions elicited newly generated details because of repeated questioning. Accuracy rates were comparable across language and interview conditions. Future research should develop an interviewing protocol that is sensitive to the challenges faced by non-native speakers.},
  selected = {true},
  preview = {plc.jpg}
}

@article{TateWylieMoss2023,
  title = {The effects of face masks on emotional appraisal ability of children with autism},
  journal = {International Journal of Developmental Disabilities},
  author = {Tate, Elizabeth K. and Wylie, Keith and Moss, Jennifer D.},
  advisees = {Elizabeth K. Tate},
  year = {2023},
  month = mar,
  pages = {1--9},
  doi = {10.1080/20473869.2023.2189765},
  url = {https://doi.org/10.1080/20473869.2023.2189765},
  issn = {2047-3869},
  abstract = {The impact of the COVID-19 pandemic drastically altered the ways in which people were able to communicate effectively. The addition of the face mask as a distracting stimulus interrupts the holistic process that people use to interpret facial expressions. The present study investigated the impact of face masking and gaze direction on emotion recognition in students with autism. Face masks reduced participants' ability to emotionally appraise sad faces, and participants showed better accuracy appraising faces with a direct gaze. Exploring how face masks impact autistic individuals' emotion recognition may benefit special educators and others who seek to improve communication with neurodiverse persons.},
  preview = {ijdd.jpg}
}

@article{WyliePenaMillerPalmerTate2022,
  title = {Observers' accuracy in detecting deception in non-native speakers versus native speakers: A systematic review},
  volume = {19},
  number = {3},
  journal = {Journal of Investigative Psychology and Offender Profiling},
  author = {Wylie, Keith and Pena, Michelle M. and Miller, Kevin B. and Palmer, Maley E. and Tate, Elizabeth K.},
  advisees = {Kevin B. Miller; Maley E. Palmer; Elizabeth K. Tate},
  year = {2022},
  month = oct,
  pages = {204--220},
  doi = {10.1002/jip.1595},
  url = {https://doi.org/10.1002/jip.1595},
  issn = {1544-4759},
  abstract = {As immigration and homeland security become of greater concern both globally and nationally, existing research on observers' ability to accurately detect deception in non-native speakers warrants review. This systematic review summarized evidence on adult observers' deception detection accuracy for non-native speakers compared to native speakers, identified response biases when judging native versus non-native speakers' statements, and explored whether accuracy varies across targets' proficiency levels. Eleven studies met inclusion criteria. Discriminability for non-native speakers was above chance in four samples. Most studies found support for a lie bias when judging non-native speakers and a truth bias when judging native speakers. The results highlight the need for better reporting of stimuli and observer samples, as well as standardized measures of language proficiency.},
  preview = {jip.jpg}
}

@article{PSASDTCollaboration2022,
  title = {A global experiment on motivating social distancing during the {COVID}-19 pandemic},
  volume = {119},
  number = {22},
  journal = {Proceedings of the National Academy of Sciences},
  author = {{Psychological Science Accelerator Self-Determination Theory Collaboration}},
  year = {2022},
  month = may,
  pages = {e2111091119},
  doi = {10.1073/pnas.2111091119},
  url = {https://doi.org/10.1073/pnas.2111091119},
  issn = {0027-8424},
  abstract = {Finding communication strategies that effectively motivate social distancing remains a global public health priority. This cross-country, preregistered experiment tested whether messages emphasizing personal agency would be more persuasive than controlling messages. Multilevel regression results indicated that messages promoting agency increased reported intentions to engage in social distancing relative to controlling messages, particularly among those who had not been following social distancing guidelines. Effects did not differ significantly across country clusters, age, gender, or political ideology. These findings suggest that promoting autonomy is a promising approach for motivating adherence to social distancing guidelines across diverse populations.},
  preview = {pnas.gif}
}

@article{MolinaroCharmanWylie2021,
  title = {Pre-identification confidence is related to eyewitness lineup accuracy across witnesses with heterogenous encoding conditions},
  volume = {45},
  number = {6},
  journal = {Law and Human Behavior},
  author = {Molinaro, Peter F. and Charman, Steve D. and Wylie, Keith},
  year = {2021},
  month = dec,
  pages = {524--541},
  doi = {10.1037/lhb0000452},
  url = {https://doi.org/10.1037/lhb0000452},
  issn = {0147-7307},
  abstract = {Eyewitness research has generally failed to show an association between eyewitnesses' pre-identification confidence in their ability to identify the perpetrator from a lineup and their subsequent identification accuracy. This lack of association may be an artifact of methodologies in which witnesses experienced homogenous encoding conditions. The present research tested whether pre-identification confidence predicts eyewitness identification accuracy across witnesses who experienced heterogeneous encoding conditions. Across 1,236 participants, pre-identification confidence was significantly related to accuracy, with higher accuracy for confident participants. Participants who identified a suspect were more confident than those who did not identify anyone, but confidence did not differ significantly across lineup types or between correct and incorrect suspect identifications.},
  preview = {lhb.gif}
}

@article{McCarthyEtAl2018,
  title = {Registered replication report on {Srull} and {Wyer} (1979)},
  volume = {1},
  number = {3},
  journal = {Advances in Methods and Practices in Psychological Science},
  author = {McCarthy, Randy J. and Skowronski, John J. and Hoogesteyn, Katherine and Verschuere, Bruno and Meijer, Ewout H. and Jim, Ariane and Charman, Steve D. and Evans, Jacqueline R. and Wylie, Keith and Yildiz, E. and others},
  year = {2018},
  month = sep,
  pages = {299--317},
  doi = {10.1177/2515245918777487},
  url = {https://doi.org/10.1177/2515245918777487},
  issn = {2515-2459},
  preview = {ampps.jpg},
  abstract = {Srull and Wyer (1979) demonstrated that exposing participants to hostility-related stimuli caused them subsequently to interpret ambiguous behaviors as more hostile. This registered replication report tested the generalizability of that finding and examined whether working memory load or priming duration moderates the effect. Ten laboratories ran the experiment with a combined sample of 1,294 undergraduate students. Meta-analytic findings indicated that exposure to hostility-related primes significantly increased hostility judgments of the target person, with effects observed across eight of the ten laboratories. Working memory load did not moderate the effect.}
}

@article{VerschuereEtAl2018,
  title = {Registered replication report on {Mazar}, {Amir}, and {Ariely} (2008)},
  volume = {1},
  number = {3},
  journal = {Advances in Methods and Practices in Psychological Science},
  author = {Verschuere, Bruno and Meijer, Ewout H. and Jim, Ariane and McCarthy, Randy J. and Hoogesteyn, Katherine and Skowronski, John J. and Orthey, Robin and Charman, Steve D. and Evans, Jacqueline R. and Wylie, Keith and Yildiz, E. and others},
  year = {2018},
  month = sep,
  pages = {321--336},
  doi = {10.1177/2515245918781032},
  url = {https://doi.org/10.1177/2515245918781032},
  issn = {2515-2459},
  preview = {ampps.jpg},
  abstract = {The self-concept maintenance theory holds that many people will cheat to maximize self-profit, but only to the extent that they can do so while maintaining a positive self-concept. This registered replication report tested the generalizability of an effect reported by Mazar et al.: a moderate positive effect of activating the concept of dishonesty on dishonest behavior. Sixty-two samples, totaling 4,080 participants, conducted the replication. Meta-analytic results indicated that the mean effect size was significantly smaller than the original effect but in the same direction, suggesting that activating the concept of dishonesty may have a real but small effect on dishonest behavior.}
}
